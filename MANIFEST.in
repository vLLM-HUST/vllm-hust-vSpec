include LICENSE
include README.md
include install.sh
include manage.sh
include release.sh
include run.sh
include uninstall.sh
recursive-include benchmarks *.py
recursive-include configs *.json *.toml
recursive-include docs *.md
recursive-include docs *.csv
recursive-include docs *.json
recursive-include examples/qwen35_three_datasets *.py *.md
recursive-include examples/issue18_frozen56 *.py *.md *.json
recursive-include profiles *.json
recursive-include scripts *.py *.sh
recursive-include tests *.py
prune benchmark_results
prune extra-info
prune static_kernel_compile_outputs
global-exclude *.py[cod]
global-exclude __pycache__
